NODE_ENV=development
PORT=3001

# Base de datos (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/escuela_digital

# Redis (cache)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=tu-secreto-jwt-minimo-32-caracteres-aqui
JWT_REFRESH_SECRET=tu-secreto-refresh-minimo-32-caracteres-aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend - tier gratuito)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@escueladigital.com

# Encriptación para API keys almacenadas
ENCRYPTION_KEY=tu-clave-encriptacion-exactamente-32-chars

# Proveedores IA
GEMINI_API_KEY=tu-clave-gemini-aqui
ANTHROPIC_API_KEY=tu-clave-anthropic-aqui
OPENAI_API_KEY=tu-clave-openai-aqui

# Frontend URL
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000

# Monitoreo (Sentry - tier gratuito)
SENTRY_DSN=https://xxx@sentry.io/xxx
